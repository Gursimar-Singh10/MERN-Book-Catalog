# MongoDB Atlas (or local) connection string
MONGO_URL=mongodb://127.0.0.1:27017/book_catalog
# Long random string. Never expose it to the client build.
JWT_SECRET=change-me-to-a-long-random-string
# Optional. Host-provided on Render; defaults to 8800 locally.
PORT=8800
# Optional. Comma-separated allowed origins, e.g. your Vercel URL. Empty = allow all.
CLIENT_URL=http://localhost:5173
